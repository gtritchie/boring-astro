{
  "name": "boring-astro",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=24.16.0"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "preview:astro": "astro build && astro preview --host 127.0.0.1 --port 4321",
    "check": "astro check && prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "TZ=America/Edmonton node --test \"src/**/*.test.ts\"",
    "pa11y": "node scripts/run-pa11y.mjs",
    "pa11y:full": "node scripts/run-pa11y-full.mjs",
    "lighthouse": "astro build && lhci autorun",
    "link-check": "bash scripts/run-link-check.sh"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.3",
    "@astrojs/markdown-satteri": "0.4.6",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@open-adventure/core": "^1.0.2",
    "astro": "^7.4.4",
    "github-slugger": "^2.0.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "pa11y-ci": "^5.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^4.156.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true,
    "puppeteer@25.16.0": true
  }
}

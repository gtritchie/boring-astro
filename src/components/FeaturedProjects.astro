---
// src/components/FeaturedProjects.astro — the retired home-page project listing
// (up to six `featured: true` projects as cards). Nothing imports it; the home
// page switched to a plain list of every project on 2026-09-20. Kept so the
// card treatment can be reinstated without re-deriving it.
import ProjectCard from "./ProjectCard.astro";
import { listProjects } from "../lib/collection-order";

const projects = (await listProjects()).filter((p) => p.data.featured).slice(0, 6);
---

<h2 class="section-label">Featured projects</h2>
{
  projects.map((p) => (
    <ProjectCard
      href={`/projects/${p.id}/`}
      title={p.data.title}
      summary={p.data.summary}
      tags={p.data.tags}
      status={p.data.status}
    />
  ))
}
<p class="all-projects-link">
  <a href="/projects/">All projects &rarr;</a>
</p>

<style>
  .section-label {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin: var(--sp-10) 0 var(--sp-4);
  }
  .all-projects-link {
    margin: var(--sp-2) 0 0;
    font-size: 0.95rem;
  }
  .all-projects-link a {
    color: var(--fg-muted);
    text-decoration: none;
  }
  .all-projects-link a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
    color: var(--fg);
  }
</style>

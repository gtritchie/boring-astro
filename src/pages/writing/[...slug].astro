---
// src/pages/writing/[...slug].astro
import ProseLayout from "../../layouts/ProseLayout.astro";
import EntryPager from "../../components/EntryPager.astro";
import { listWriting, pagerLink } from "../../lib/collection-order";
import { render } from "astro:content";

export async function getStaticPaths() {
  const posts = await listWriting();
  // Sorted newest-first, so the lower index is the newer post.
  return posts.map((p, i) => ({
    params: { slug: p.id },
    props: { entry: p, newer: pagerLink(posts[i - 1]), older: pagerLink(posts[i + 1]) },
  }));
}

const { entry, newer, older } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
---

<ProseLayout
  title={data.title}
  description={data.description}
  publishedAt={data.publishedAt}
  {...data.updatedAt && { updatedAt: data.updatedAt }}
>
  <Content />
  <EntryPager
    slot="pager"
    ariaLabel="More writing"
    prevLabel="Newer"
    nextLabel="Older"
    prev={newer}
    next={older}
  />
</ProseLayout>

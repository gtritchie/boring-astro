---
import BaseLayout from "../layouts/BaseLayout.astro";
import EntryList from "../components/EntryList.astro";
import { listProjects, listWriting } from "../lib/collection-order";

// Every non-draft project, newest first (listProjects owns the ordering). The
// previous featured-cards treatment lives, unused, in FeaturedProjects.astro.
const projects = (await listProjects()).map((p) => ({
  href: `/projects/${p.id}/`,
  title: p.data.title,
  year: p.data.displayYear ?? String(p.data.startedAt.getUTCFullYear()),
}));

const writing = (await listWriting()).slice(0, 3);

const writingEntries = writing.map((post) => ({
  href: `/writing/${post.id}/`,
  title: post.data.title,
  description: post.data.description,
  date: post.data.publishedAt,
}));
---

<BaseLayout
  title="Gary Ritchie"
  description="Personal site of Gary Ritchie — projects, writing, and tinkering."
>
  <main id="main">
    <h1>Gary's Personal Site</h1>
    <h2 class="section-label">Software I've Worked On</h2>
    <ul class="project-list">
      {
        projects.map((p) => (
          <li>
            <a href={p.href}>{p.title}</a> ({p.year})
          </li>
        ))
      }
    </ul>

    <h2 class="section-label">Recent writing</h2>
    <EntryList entries={writingEntries} />
  </main>
</BaseLayout>

<style>
  .section-label {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin: var(--sp-10) 0 var(--sp-4);
  }
  /* Multi-column rather than grid so the newest-first order reads down the
     first column and continues down the second. */
  .project-list {
    columns: 2;
    column-gap: var(--sp-8);
    margin: 0;
    padding-left: 1.25em;
  }
  .project-list li {
    break-inside: avoid;
    margin-bottom: var(--sp-2);
  }
  @media (max-width: 640px) {
    .project-list {
      columns: 1;
    }
  }
</style>

---
// src/pages/interests/[...slug].astro
import ProseLayout from "../../layouts/ProseLayout.astro";
import EntryPager from "../../components/EntryPager.astro";
import { listInterests, pagerLink } from "../../lib/collection-order";
import { render } from "astro:content";

export async function getStaticPaths() {
  const interests = await listInterests();
  return interests.map((p, i) => ({
    params: { slug: p.id },
    props: { entry: p, prev: pagerLink(interests[i - 1]), next: pagerLink(interests[i + 1]) },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
---

<ProseLayout title={data.title} description={data.summary}>
  <p class="lede">{data.summary}</p>
  <Content />
  <EntryPager slot="pager" ariaLabel="More interests" prev={prev} next={next} />
</ProseLayout>

<style>
  .lede {
    font-size: 1.05rem;
    color: var(--fg-muted);
  }
</style>
